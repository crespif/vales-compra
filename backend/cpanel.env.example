# Configuración para el servidor cPanel (copiar como .env en la carpeta de la app)
NODE_ENV=production

# Base MariaDB creada en cPanel (los nombres llevan el prefijo de la cuenta)
DB_TYPE=mariadb
DATABASE_URL="mysql://wmeq5232_vales:CLAVE_DE_LA_BASE@localhost:3306/wmeq5232_vales"

# Clave para firmar las sesiones: larga y aleatoria. Para generarla:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="PEGAR_ACA_LA_CLAVE_GENERADA"
JWT_EXPIRES_IN="8h"

# Dirección pública (la que abre el QR del proveedor)
PUBLIC_BASE_URL="https://vales.celta.com.ar"
VIGENCIA_DIAS=7

# GLM desde afuera de la red de CELTA
GLM_API_URL="http://200.45.235.121:3000"
GLM_SYNC_MINUTOS=60
